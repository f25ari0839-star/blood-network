<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' · BloodBridge' : 'BloodBridge' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <% if (currentUser) { %>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand">
        <span class="brand-mark">+</span>
        <span class="brand-name">BloodBridge</span>
      </div>
      <nav class="nav">
        <a href="/dashboard" class="<%= locals.activeNav === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/requests" class="<%= locals.activeNav === 'requests' ? 'active' : '' %>">Requests</a>
        <a href="/requests/new" class="<%= locals.activeNav === 'new-request' ? 'active' : '' %>">Post a Request</a>
        <a href="/donors" class="<%= locals.activeNav === 'donors' ? 'active' : '' %>">Find Donors</a>
        <a href="/donor/register" class="<%= locals.activeNav === 'donor-register' ? 'active' : '' %>">My Donor Profile</a>
      </nav>
      <div class="sidebar-footer">
        <div class="signed-in-as">Signed in as<br><strong><%= currentUser.name %></strong></div>
        <form action="/logout" method="POST">
          <button type="submit" class="btn-link">Log out</button>
        </form>
      </div>
    </aside>
    <main class="content">
  <% } else { %>
  <main class="content content--auth">
  <% } %>
